{
  "format": "ladb_styler_preset",
  "version": 1,
  "name": "Styler Steel",
  "theme": {
    "enabled": true,
    "toolbar": {
      "enabled": true,
      "scope": "all",
      "titles": [],
      "radius": 4,
      "border_width": 1,
      "normal": {
        "background": "",
        "border": ""
      },
      "hover": {
        "background": "#e2e2e2",
        "border": "#4a4a4a"
      },
      "checked": {
        "background": "#b8b8b8",
        "border": "#3a3a3a"
      },
      "pressed": {
        "background": "#b8b8b8",
        "border": "#3a3a3a"
      },
      "bar": {
        "background": "",
        "border": "",
        "border_width": 1,
        "radius": 0,
        "padding": 8
      },
      "area": {
        "background": "#cfcfcf"
      },
      "separator": {
        "color": "#a8a8a8",
        "inset": 6
      },
      "handle": {
        "style": "dots",
        "color": "#8a8a8a"
      }
    },
    "tabs": {
      "enabled": true,
      "background": "#3a3a3a",
      "normal": {
        "background": "#3a3a3a",
        "text": "#c8c8c8"
      },
      "hover": {
        "background": "#4b4b4b",
        "text": "#ffffff"
      },
      "selected": {
        "background": "#cfcfcf",
        "text": "#000000"
      },
      "plus": {
        "radius": 4,
        "gap": 7,
        "size": 22,
        "font_size": 15,
        "normal": {
          "background": "transparent",
          "border": "transparent",
          "text": "#c8c8c8"
        },
        "hover": {
          "background": "#585858",
          "border": "",
          "text": "#ffffff"
        },
        "pressed": {
          "background": "#676767",
          "border": "",
          "text": ""
        }
      },
      "frame": {
        "color": "transparent",
        "width": 1
      },
      "close": {
        "color": "#9a9a9a",
        "size": 10,
        "radius": 4,
        "hover": {
          "background": "#d00000",
          "color": "#ffffff"
        },
        "pressed": {
          "background": "#700000",
          "color": "#ffffff"
        }
      }
    },
    "scenes": {
      "enabled": true,
      "background": "#8a8a8a",
      "line": "#5a5a5a",
      "height": 28,
      "normal": {
        "background": "transparent",
        "text": "#ffffff"
      },
      "hover": {
        "background": "#5a5a5a",
        "text": "#ffffff"
      },
      "selected": {
        "background": "#3a3a3a",
        "text": "#ffffff"
      },
      "plus": {
        "radius": 4,
        "gap": 0,
        "size": 22,
        "font_size": 15,
        "normal": {
          "background": "transparent",
          "border": "transparent",
          "text": "#ffffff"
        },
        "hover": {
          "background": "#6a6a6a",
          "border": "",
          "text": "#ffffff"
        },
        "pressed": {
          "background": "#3a3a3a",
          "border": "",
          "text": ""
        }
      },
      "search": {
        "radius": 4,
        "width": 31,
        "height": 28,
        "normal": {
          "background": "transparent",
          "border": "transparent",
          "icon": "#ffffff"
        },
        "hover": {
          "background": "#6a6a6a",
          "border": "",
          "icon": "#ffffff"
        },
        "pressed": {
          "background": "#5a5a5a",
          "border": "",
          "icon": ""
        }
      }
    },
    "statusbar": {
      "enabled": true,
      "background": "#cfcfcf",
      "text": "#1a1a1a",
      "radius": 4,
      "hover": {
        "background": "#e2e2e2",
        "border": ""
      },
      "pressed": {
        "background": "#b8b8b8",
        "border": ""
      }
    },
    "scrollbars": {
      "enabled": true,
      "width": 10,
      "radius": 3,
      "track": "#cfcfcf",
      "normal": "#9a9a9a",
      "hover": "#4a4a4a",
      "pressed": ""
    },
    "messagebox": {
      "enabled": true,
      "background": "#d6d6d6",
      "text": "#1d1d1f",
      "radius": 5,
      "center": true,
      "hide_icon": true,
      "button": {
        "normal": {
          "background": "#ececec",
          "text": "#1d1d1f",
          "border": "#a8a8a8"
        },
        "hover": {
          "background": "",
          "text": "",
          "border": ""
        },
        "pressed": {
          "background": "#c4c4c4",
          "text": "",
          "border": ""
        }
      },
      "default": {
        "normal": {
          "background": "#007aff",
          "text": "#ffffff",
          "border": "#006ae0"
        },
        "hover": {
          "background": "",
          "text": "",
          "border": ""
        },
        "pressed": {
          "background": "#0062cc",
          "text": "",
          "border": ""
        }
      }
    },
    "window": {
      "enabled": true,
      "title_bar": "#3a3a3a"
    },
    "palette": {
      "enabled": true,
      "window": "#cfcfcf",
      "window_text": "#000000",
      "base": "#e6e6e6",
      "alternate_base": "#dadada",
      "text": "#000000",
      "placeholder_text": "#6e6e6e",
      "button": "#e2e2e2",
      "button_text": "#000000",
      "highlight": "#4a4a4a",
      "highlighted_text": "#ffffff",
      "lines": "#a8a8a8",
      "gradient": ""
    },
    "extra_qss": ""
  }
}
