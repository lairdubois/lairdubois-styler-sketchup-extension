{
  "format": "ladb_styler_preset",
  "version": 1,
  "name": "Styler BlueSky",
  "theme": {
    "enabled": true,
    "toolbar": {
      "enabled": true,
      "scope": "all",
      "titles": [],
      "radius": 4,
      "border_width": 1,
      "normal": {
        "background": "",
        "border": ""
      },
      "hover": {
        "background": "#dfecf8",
        "border": "#3e7ab6"
      },
      "checked": {
        "background": "#c7ddf2",
        "border": "#3e7ab6"
      },
      "pressed": {
        "background": "#c7ddf2",
        "border": "#3e7ab6"
      },
      "bar": {
        "background": "",
        "border": "",
        "border_width": 1,
        "radius": 0,
        "padding": 8
      },
      "area": {
        "background": "#f2f2f2"
      },
      "separator": {
        "color": "#cfcfcf",
        "inset": 6
      },
      "handle": {
        "style": "native",
        "color": "#979797"
      }
    },
    "tabs": {
      "enabled": true,
      "background": "#f2f2f2",
      "normal": {
        "background": "#f2f2f2",
        "text": "#000000"
      },
      "hover": {
        "background": "#c2c2c2",
        "text": ""
      },
      "selected": {
        "background": "#c7ddf2",
        "text": ""
      },
      "plus": {
        "radius": 4,
        "gap": 7,
        "size": 22,
        "font_size": 15,
        "normal": {
          "background": "transparent",
          "border": "transparent",
          "text": "#4a4a4a"
        },
        "hover": {
          "background": "#666666",
          "border": "",
          "text": "#ffffff"
        },
        "pressed": {
          "background": "#333333",
          "border": "",
          "text": ""
        }
      },
      "frame": {
        "color": "transparent",
        "width": 1
      },
      "close": {
        "color": "#8c8c8c",
        "size": 10,
        "radius": 4,
        "hover": {
          "background": "#d00000",
          "color": "#ffffff"
        },
        "pressed": {
          "background": "#700000",
          "color": "#ffffff"
        }
      }
    },
    "scenes": {
      "enabled": true,
      "background": "#c7ddf2",
      "line": "#3e7ab6",
      "height": 28,
      "normal": {
        "background": "transparent",
        "text": ""
      },
      "hover": {
        "background": "#474747",
        "text": "#ffffff"
      },
      "selected": {
        "background": "#3e7ab6",
        "text": "#ffffff"
      },
      "plus": {
        "radius": 4,
        "gap": 0,
        "size": 22,
        "font_size": 15,
        "normal": {
          "background": "transparent",
          "border": "transparent",
          "text": ""
        },
        "hover": {
          "background": "#3e7ac0",
          "border": "",
          "text": "#ffffff"
        },
        "pressed": {
          "background": "#3e7ab6",
          "border": "",
          "text": ""
        }
      },
      "search": {
        "radius": 4,
        "width": 31,
        "height": 28,
        "normal": {
          "background": "transparent",
          "border": "transparent",
          "icon": "#1f5d99"
        },
        "hover": {
          "background": "",
          "border": "",
          "icon": "#0d3b66"
        },
        "pressed": {
          "background": "",
          "border": "",
          "icon": ""
        }
      }
    },
    "statusbar": {
      "enabled": true,
      "background": "#f2f2f2",
      "text": "",
      "radius": 4,
      "hover": {
        "background": "",
        "border": ""
      },
      "pressed": {
        "background": "",
        "border": ""
      }
    },
    "scrollbars": {
      "enabled": true,
      "width": 10,
      "radius": 3,
      "track": "#f2f2f2",
      "normal": "#c2c2c2",
      "hover": "#3e7ab6",
      "pressed": ""
    },
    "messagebox": {
      "enabled": true,
      "background": "#ececec",
      "text": "#1d1d1f",
      "radius": 5,
      "center": true,
      "hide_icon": true,
      "button": {
        "normal": {
          "background": "#ffffff",
          "text": "#1d1d1f",
          "border": "#c4c4c4"
        },
        "hover": {
          "background": "",
          "text": "",
          "border": ""
        },
        "pressed": {
          "background": "#dcdcdc",
          "text": "",
          "border": ""
        }
      },
      "default": {
        "normal": {
          "background": "#007aff",
          "text": "#ffffff",
          "border": "#006ae0"
        },
        "hover": {
          "background": "",
          "text": "",
          "border": ""
        },
        "pressed": {
          "background": "#0062cc",
          "text": "",
          "border": ""
        }
      }
    },
    "window": {
      "enabled": true,
      "title_bar": "#1e4069"
    },
    "palette": {
      "enabled": true,
      "window": "#f2f2f2",
      "window_text": "#000000",
      "base": "#ffffff",
      "alternate_base": "#f7f7f7",
      "text": "#000000",
      "placeholder_text": "#8c8c8c",
      "button": "#ffffff",
      "button_text": "#000000",
      "highlight": "#3e7ab6",
      "highlighted_text": "#ffffff",
      "lines": "#cfcfcf",
      "gradient": ""
    },
    "extra_qss": ""
  }
}
